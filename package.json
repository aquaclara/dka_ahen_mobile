{
  "name": "dka_ahen_mobile",
  "repository": "git@github.com:aquaclara/dka_ahen_mobile.git",
  "author": "aquaclara",
  "license": "BSD-2-Clause",
  "private": true,
  "scripts": {
    "build": "tsc --project src/tsconfig.json && sass src/styles.scss dist/styles.css --style=expanded --no-source-map",
    "typecheck": "tsc --noEmit --project src/tsconfig.json",
    "test": "prettier --check \"**/*.{js,ts,json,scss,html,css,md}\"",
    "fix": "prettier --write \"**/*.{js,ts,json,scss,html,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "singleQuote": true
  },
  "engines": {
    "node": ">=22"
  }
}
